{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dev-workflow project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enabledCapabilities"],
  "$defs": {"deploymentIdentifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}},
  "properties": {
    "schemaVersion": {"const": 1, "type": "integer"},
    "enabledCapabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["api:rest-openapi", "api:graphql", "api:grpc", "api:websocket", "api:sse", "containers:oci-docker", "containers:compose", "cicd:github-actions", "cicd:gitlab-ci", "cicd:jenkins", "cicd:generic", "deployment:compose", "deployment:kubernetes-helm", "deployment:vm-systemd", "deployment:serverless", "deployment:generic", "release"]}},
    "commands": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {"command": {"type": "string", "minLength": 1}, "cwd": {"type": "string", "default": "."}}}},
    "documents": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "extensions": {"type": "object", "additionalProperties": false, "properties": {"deployment": {"type": "object", "additionalProperties": false, "required": ["components", "environments"], "properties": {"components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/deploymentIdentifier"}}, "environments": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/deploymentIdentifier"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["capability", "target", "commands", "production", "components"], "properties": {"capability": {"enum": ["deployment:compose", "deployment:kubernetes-helm", "deployment:vm-systemd", "deployment:serverless", "deployment:generic"]}, "target": {"$ref": "#/$defs/deploymentIdentifier"}, "commands": {"type": "object", "additionalProperties": false, "description": "Values reference existing keys in root commands; cross-object references are checked by workflow_config.py.", "properties": {"preflight": {"$ref": "#/$defs/deploymentIdentifier"}, "deploy": {"$ref": "#/$defs/deploymentIdentifier"}, "health": {"$ref": "#/$defs/deploymentIdentifier"}, "smoke": {"$ref": "#/$defs/deploymentIdentifier"}, "rollback": {"$ref": "#/$defs/deploymentIdentifier"}, "backup": {"$ref": "#/$defs/deploymentIdentifier"}, "restore": {"$ref": "#/$defs/deploymentIdentifier"}, "migrate": {"$ref": "#/$defs/deploymentIdentifier"}}}, "production": {"type": "boolean"}, "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/deploymentIdentifier"}, "description": "Must be a subset of deployment components; checked by workflow_config.py."}}}}}}, "release": {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {"strategy": {"enum": ["none", "commit-sha", "semver-tag"]}, "tagPrefix": {"type": "string", "default": "v"}, "components": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}}
  }
}
